generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model GlpiTicket {
  id                         Int       @id @default(autoincrement())
  name                       String    @db.VarChar(255)
  content                    String?   @db.LongText
  status                     Int       @default(1) // 1=new, 2=assigned, 3=planned, 4=pending, 5=solved, 6=closed
  priority                   Int       @default(3) // 1=very_low, 2=low, 3=medium, 4=high, 5=very_high, 6=major
  urgency                    Int       @default(3)
  impact                     Int       @default(3)
  type                       Int       @default(1) // 1=incident, 2=request
  date_creation              DateTime?
  date_mod                   DateTime?
  solvedate                  DateTime?
  closedate                  DateTime?
  time_to_resolve            DateTime?
  users_id_recipient         Int?
  itilcategories_id          Int?
  entities_id                Int       @default(0)
  takeintoaccount_delay_stat Int       @default(0)
  solve_delay_stat           Int       @default(0)
  actiontime                 Int       @default(0) // tempo gasto total (segundos)
  waiting_duration           Int       @default(0)
  global_validation          Int       @default(1)
  is_deleted                 Boolean   @default(false)

  @@index([status])
  @@index([itilcategories_id])
  @@index([date_creation])
  @@index([type])
  @@index([priority])
  @@index([entities_id])
  @@map("glpi_tickets")
}

model GlpiUser {
  id         Int     @id @default(autoincrement())
  name       String  @db.VarChar(255)
  realname   String? @db.VarChar(255)
  firstname  String? @db.VarChar(255)
  password   String? @db.VarChar(255)
  is_active  Boolean @default(true)
  is_deleted Boolean @default(false)

  @@map("glpi_users")
}

model GlpiUserEmail {
  id         Int     @id @default(autoincrement())
  users_id   Int
  email      String  @db.VarChar(255)
  is_default Boolean @default(false)

  @@index([users_id])
  @@map("glpi_useremails")
}

model GlpiItilCategory {
  id                Int     @id @default(autoincrement())
  name              String  @db.VarChar(255)
  completename      String? @db.VarChar(255)
  itilcategories_id Int?

  @@map("glpi_itilcategories")
}

// type: 1=requester, 2=assigned (técnico), 3=observer
model GlpiTicketUser {
  id         Int @id @default(autoincrement())
  tickets_id Int
  users_id   Int
  type       Int @default(1)

  @@unique([tickets_id, users_id, type])
  @@index([users_id, type])
  @@index([tickets_id])
  @@map("glpi_tickets_users")
}

model GlpiTicketSatisfaction {
  id            Int       @id @default(autoincrement())
  tickets_id    Int       @unique
  type          Int       @default(1)
  date_begin    DateTime?
  date_answered DateTime?
  satisfaction  Int? // 1-5
  comment       String?   @db.Text

  @@map("glpi_ticketsatisfactions")
}

model GlpiGroup {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(255)
  is_assign Boolean @default(true) // grupo pode ser atribuído a tickets
  is_requester Boolean @default(true)
  is_deleted Boolean @default(false)

  @@map("glpi_groups")
}

// type: 1=requester, 2=assigned
model GlpiGroupTicket {
  id         Int @id @default(autoincrement())
  tickets_id Int
  groups_id  Int
  type       Int @default(1)

  @@index([tickets_id])
  @@index([groups_id, type])
  @@map("glpi_groups_tickets")
}

model GlpiSla {
  id              Int    @id @default(autoincrement())
  name            String @db.VarChar(255)
  type            Int    @default(1) // 1=TTO, 2=TTR
  number_time     Int    @default(0)
  definition_time String @db.VarChar(255) // minute, hour, day
  is_deleted      Boolean @default(false)

  @@map("glpi_slas")
}
